# The game assets in client/assets/game/ are tracked, with the copyright holders'
# permission: the build from the original SWFs, the AI-upscaled HD copies
# (tools/upscale_textures.py) and the saved maps (tools/save_maps.py).

__pycache__/
*.pyc
node_modules/

# Real-ESRGAN, downloaded by tools/upscale_textures.py
tools/.realesrgan/

# Drawing templates made from the original art (tools/redrawn_art.py)
art/templates/

# The host's own settings for tools/host.py (Start-Online.cmd)
host.json

# The game server's own data, kept on the host only: player accounts and passwords,
# round records and login addresses (bbh-server-hunter-fix_2.py)
users.db
users.db.*
login_ips.log

# The bridge's Python add-ons (websockets), installed on the host with pip --target
.python-packages/
